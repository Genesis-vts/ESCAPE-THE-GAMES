# =============================================================================
# ESCAPE-THE-GAMES — exemplo de variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie para .env  ->  cp .env.example .env
# NUNCA versione o arquivo .env. NUNCA coloque valores reais neste arquivo.
# Em produção, use um cofre (AWS Secrets Manager / SSM / GCP Secret Manager) e
# injete as variáveis no ambiente do container — não use arquivo .env.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001
LOG_LEVEL=info
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# --- Banco de dados ----------------------------------------------------------
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://escape:escape@localhost:5432/escape_the_games

# --- Redis (rate limit distribuído e fila na v1) -----------------------------
REDIS_URL=redis://localhost:6379

# --- Autenticação ------------------------------------------------------------
# Gere um segredo forte: openssl rand -base64 48
# Em produção, rotacione trimestralmente (ver SECURITY_AND_COMPLIANCE.md §5.2).
JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-no-minimo-32-caracteres
JWT_ISSUER=escape-the-games
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Criptografia de dados em repouso ----------------------------------------
# ID da chave (KEK) no KMS usada para envelope encryption das colunas sensíveis.
KMS_KEY_ID=
# Fallback local APENAS para desenvolvimento (32 bytes em base64).
# Em produção esta variável deve ficar VAZIA e o KMS deve ser usado.
LOCAL_ENCRYPTION_KEY=

# --- Twilio (SMS) ------------------------------------------------------------
# Console: https://console.twilio.com  ->  Account SID / Auth Token
# Se estas variáveis estiverem vazias, a API usa um provedor de console (mock)
# e nenhum SMS real é enviado — comportamento padrão em desenvolvimento.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número remetente em formato E.164 (ex.: +5511999999999) ou Messaging Service SID
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- SendGrid (e-mail) -------------------------------------------------------
# Chave com permissão apenas de "Mail Send" (princípio do menor privilégio).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=apoio@escape-the-games.example
SENDGRID_FROM_NAME=ESCAPE-THE-GAMES

# --- Push (FCM / APNs) -------------------------------------------------------
# Caminho para o JSON da service account do Firebase (não versionar o arquivo).
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tech.genesisvts.escapethegames

# --- Observabilidade ---------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Regras de negócio -------------------------------------------------------
PANIC_RATE_LIMIT_PER_HOUR=5
PANIC_RATE_LIMIT_PER_DAY=10
CONTACT_VERIFICATION_TTL_MINUTES=15
MAX_CONTACTS_PER_USER=10
CONSENT_VERSION=v1
